#!/usr/bin/env bash

handleErr(){
  echo "Error: option $1 expected $2 arguments but got $3"
  exit 1
}

list(){
  if [[ $# > 1  ]]; then
    handleErr "-v" 0 $(($# - 1))
  fi
  echo "List all items"
  return 0
}

add(){
  if [[ $# != 2  ]]; then
    handleErr "-a" 1 $(($# - 1))
  fi
  item=$2
  echo "Adding item: $item"
  return 0
}

remove(){
  if [[ $# != 2  ]]; then
    handleErr "-r" 1 $(($# - 1))
  fi
  id=$2
  echo "Removing item with id: $id"
  return 0
}

mark(){
  if [[ $# != 2  ]]; then
    handleErr "-m" 1 $(($# - 1))
  fi
  id=$2
  echo "Item $id done!"
  return 0
}

#Driver
case "$1" in
  "-v")
    list "$@"
    ;;
  "-a")
    add "$@"
    ;;
  
  "-r")
    remove "$@"
    ;;
  
  "-m")
    mark "$@"
    ;;
esac

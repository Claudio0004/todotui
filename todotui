#!/usr/bin/env bash

handleErr(){
  echo "Error: option $1 expected $2 arguments but got $3"
  exit 1
}

list(){
  if [[ $# > 1  ]]; then
    handleErr "-v" 0 $(($# - 1))
  fi

  #Check if todolist exists
  if [[ ! -f todolist.txt ]] || [[ ! -f status.txt  ]]; then
    echo "Nothing to do."
    return 0
  fi

  #Make associative array for the status of each item
  declare -A status
  while read -r line; do
     val=$(echo "$line" | cut -c 3)
     id=$(echo "$line" | cut -c 1)
     status["$id"]="$val"
  done < <(cat status.txt)

  #Print out the completed tasks as crossed text
  while read -r line; do
    id=$(echo "$line" | cut -c 1)
    item=$(echo "$line" | cut -c 4-)
    print_id=$(($id+1))
    if [[ "${status["$id"]}" == "1"  ]]; then
      echo -e "\e[9m$print_id. $item\e[0m"
    else
      echo "$print_id. $item"
    fi
  done < <(cat todolist.txt)

  return 0
}

add(){
  if [[ $# != 2  ]]; then
    handleErr "-a" 1 $(($# - 1))
  fi
  
  #Get progressive id from todolist.txt
  id=`awk 'END{print $1}' todolist.txt 2>/dev/null | cut -c 1`
  echo $id
  if [[ -z "$id" ]]; then
    id="-1"
  fi

  #N. foo bar baz
  item="$((id + 1)). $2"
  echo "$item" >> todolist.txt
  echo "$((id + 1)) 0" >> status.txt
  return 0
}

remove(){
  if [[ $# != 2  ]]; then
    handleErr "-r" 1 $(($# - 1))
  fi
  target=$(($2-1))

  #Check if item in list
  last=`awk 'END{print $1}' todolist.txt 2>/dev/null | cut -c 1`
  if [[ $target > $last  ]]; then
    echo "Error: no item corresponding to number $2"
    return 1
  fi

  #Remove the item
  sed -i "/$target/d" todolist.txt
  sed -i "/$target/d" status.txt

  #Update the ids
  awk -v target=$target '{ if($1 > target) $1=$1-1"."; print $0}' todolist.txt > tmp && mv tmp todolist.txt
  awk -v target=$target '{ if($1 > target) $1=$1-1; print $0}' status.txt > tmp && mv tmp status.txt
  return 0
}

mark(){
  if [[ $# != 2  ]]; then
    handleErr "-m" 1 $(($# - 1))
  fi
  id=$(($2-1))

  #Get the status
  old=$(awk -v id="$id" '($1==id) {print $2}' status.txt 2>/dev/null)
  if [[ -z "$old" ]]; then
    echo "Item $2 not found"
    exit 1
  fi

  #Flip the status
  new="0"
  if [[ "$old" == "0"  ]]; then
    new="1"
  fi
  sed -i "s/$id $old/$id $new/" status.txt
  [[ "$new" == "1"  ]] && echo "Item $2 done!" || echo "Item $2 un-checked!"
  return 0
}

clear(){
  rm todolist.txt status.txt
  echo "Todo list cleared!"
  return 0
}

#Driver
case "$1" in
  "-v")
    list "$@"
    ;;
  "-a")
    add "$@"
    ;;
  
  "-r")
    remove "$@"
    ;;
  
  "-m")
    mark "$@"
    ;;

  "-c")
    clear
    ;;

  "-g" | "")
    bash tui_manager
esac

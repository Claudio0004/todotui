#!/usr/bin/env bash

declare -a status=()
declare -a items=()
declare item_count
declare position

init_tui(){
#  printf '\e7' # save cursor position
#  printf '\e[H' # move cursor to home position
  printf '\e[?1049h' # enter the alternate screen
  load_items

  return 0
}

exit_tui(){
  printf '\e[?1049l' # exit the alternate screen
#  printf '\e8' # restore cursor position

  return 0
}

load_items(){
  #Check if todolist exists
  if [[ ! -f todolist.txt ]] || [[ ! -f status.txt  ]]; then
    return 0
  fi

  #Populate associative array for the status of each item
  while read -r line; do
     val=$(echo "$line" | cut -c 3)
     id=$(echo "$line" | cut -c 1)
     status+="$val"
  done < <(cat status.txt)

  #Populate array for each item
  while read -r line; do
    item=$(echo "$line" | cut -c 4-)
    items+=("$item")
  done < <(cat todolist.txt)

  item_count=${#items[@]}
  position=$(( $item_count ))

  return 0
}

draw_items(){
  printf '\e[H\e[J'

  #Print out the completed tasks as crossed text
  for i in "${!items[@]}"; do
    if [[ "${status["$i"]}" == "1"  ]]; then
      echo -e "\e[9m$i. ${items[i]}\e[0m"
    else
      echo "$i. ${items[i]}"
    fi
  done
  echo ""

  #Reset cursor position
  for ((i=position; i<=item_count; i++)); do
    printf "\e[1A"
  done

  return 0
}

move_up(){
  if [[ $position > 0 ]]; then
    printf "\e[1A"
    position=$(( $position - 1  ))
  fi

  return 0
}

move_down(){
  if [[ $position < $(( $item_count ))  ]]; then
    printf "\e[1B"
    position=$(( $position + 1 ))
  fi

  return 0
}

mark(){
  if [[ $position < $(( $item_count + 1 ))  ]]; then
    if [[ "${status["$position"]}" == 1 ]]; then
      status["$position"]=0
    else
      status["$position"]=1
    fi

    draw_items
  fi

  return 0
}

clear(){
  status=()
  items=()
  item_count=0
  position=1

  draw_items

  return 0
}

remove(){
  unset items[$position]
  unset status[$position]
  items=("${items[@]}")
  status=("${status[@]}")

  item_count=$(($item_count-1))
  draw_items

  return 0
}

commit(){
 echo "commit"
}

main(){
  init_tui
  draw_items

  local cmd
  while read -sn 1 cmd; do
    if [[ "$cmd" == "q"  ]]; then
      exit_tui
      break
    elif [[ "$cmd" == "m" ]]; then
      mark
    elif [[ "$cmd" == "c" ]]; then
      clear
    elif [[ "$cmd" == "r" ]]; then
      remove
    elif [[ "$cmd" == "["  ]]; then # detect arrow keypress
      read -n 1 next
      if [[ "$next" == "A"  ]]; then
        move_up
      elif [[ "$next" == "B"  ]]; then
        move_down
      fi
    fi
  done
}

main
